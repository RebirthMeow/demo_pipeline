# .env.example — sample environment for the review Discord bot.
# Copy to .env (DO NOT COMMIT — it's in .gitignore) and fill in.
#
# Or set these as User env vars in Windows so they persist across sessions:
#   [System.Environment]::SetEnvironmentVariable('DISCORD_TOKEN','...','User')

# REQUIRED: bot token from https://discord.com/developers/applications
# Generate one by creating an Application → Bot → Reset Token.
# Treat this like a password — never commit, never paste in chat.
DISCORD_TOKEN=

# REQUIRED: numeric Discord server (guild) ID where the bot operates.
# Right-click your server icon → Copy Server ID (Developer Mode must be on
# in Discord settings → Advanced).
DISCORD_GUILD_ID=

# REQUIRED: numeric channel ID where /post-batch puts the clips.
# Right-click the channel → Copy Channel ID.
DISCORD_CHANNEL_ID=

# OPTIONAL: numeric role ID to gate voting (only members with this role
# can vote).  Leave empty to allow any guild member to vote.
DISCORD_ROLE_ID=

# OPTIONAL: minimum Discord account age in days for voting.  Reject votes
# from accounts younger than this (basic anti-throwaway-account gate).
# Leave empty to disable.
DISCORD_MIN_ACCOUNT_DAYS=

# OPTIONAL: sqlite db path.  Defaults to <reviewbot dir>/votes.db.
# REVIEWBOT_DB=
