# .env.example — sample environment for the JACTF highlight pipeline
#
# Copy to .env (or set these in your shell / system env) and adjust paths.
# The pipeline auto-detects the repo root from where its scripts live, so
# you usually don't need to set JACTF_ROOT.  JACTF_GAMEDATA almost always
# needs to be set since JKA installs vary per machine.

# Override the project root.  Default: auto-detected from script location.
# Useful only if you've moved scripts out of the repo tree.
# JACTF_ROOT=D:\path\to\your\jactf-pipeline

# REQUIRED on most machines: the directory containing jamme.exe and the mme/
# subfolder.  Default falls back to <JACTF_ROOT>/a full jka install/...
# but that's the original developer's layout, not yours.
# Examples:
#   JACTF_GAMEDATA=C:\Program Files (x86)\Steam\steamapps\common\Jedi Academy\GameData
#   JACTF_GAMEDATA=D:\Games\Jedi Academy\GameData
JACTF_GAMEDATA=
